{
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/booking", "destination": "/booking/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/terms-of-service", "destination": "/terms-of-service/index.html" }
  ],
  "redirects": [
    { "source": "/about/", "destination": "/about", "type": 301 },
    { "source": "/services/", "destination": "/services", "type": 301 },
    { "source": "/booking/", "destination": "/booking", "type": 301 },
    { "source": "/contact/", "destination": "/contact", "type": 301 },
    { "source": "/privacy-policy/", "destination": "/privacy-policy", "type": 301 },
    { "source": "/terms-of-service/", "destination": "/terms-of-service", "type": 301 }
  ]
}
